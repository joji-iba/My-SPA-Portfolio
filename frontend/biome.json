{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!.next",
      "!!out",
      "!!build",
      "!!dist",
      "!!coverage",
      "!!public",
      "!!package-lock.json",
      "!!next-env.d.ts",
      "!!.vercel"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noAriaUnsupportedElements": "warn",
        "useAltText": "warn",
        "useAriaPropsForRole": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "useValidAriaProps": "warn",
        "useValidAriaValues": "warn"
      },
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "warn",
        "noChildrenProp": "error",
        "noNextAsyncClientComponent": "warn",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "useInlineScriptId": "error",
        "useJsxKeyInIterable": "error"
      },
      "performance": {
        "noImgElement": "warn",
        "noSyncScripts": "warn",
        "noUnwantedPolyfillio": "warn",
        "useGoogleFontPreconnect": "warn"
      },
      "security": {
        "noBlankTarget": "off",
        "noDangerouslySetInnerHtmlWithChildren": "error"
      },
      "style": {
        "noHeadElement": "warn"
      },
      "suspicious": {
        "noCommentText": "error",
        "noDocumentImportInPage": "error",
        "noDuplicateJsxProps": "error",
        "noHeadImportInDocument": "error",
        "noUnknownAttribute": "off",
        "useGoogleFontDisplay": "warn"
      },
      "preset": "none"
    }
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
